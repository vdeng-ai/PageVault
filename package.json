{
  "name": "htmlbed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev:admin": "pnpm --filter @htmlbed/admin dev",
    "dev:worker": "pnpm --filter @htmlbed/worker dev",
    "format": "prettier --check .",
    "lint": "pnpm --filter @htmlbed/core run build && eslint . --max-warnings=0",
    "test": "pnpm --filter @htmlbed/core run build && vitest run",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^22.13.14",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.33.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
