{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "htmlbed",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../admin/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "r2_buckets": [
    {
      "binding": "HTML_BUCKET",
      "bucket_name": "htmlbed-files",
    },
    {
      "bucket_name": "htmlbed-files",
      "binding": "htmlbed_files",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "htmlbed-db",
      "database_id": "ccc1b8d1-f285-442a-b537-a551a6bfe1ea",
      "migrations_dir": "../../migrations",
    },
  ],
  "triggers": {
    "crons": ["17 3 * * *"],
  },
  "secrets": {
    "required": [
      "APP_ENV",
      "PUBLIC_BASE_URL",
      "ADMIN_BASE_URL",
      "DEFAULT_URL_EXPIRE_DAYS",
      "DEFAULT_FILE_EXPIRE_DAYS",
      "MAX_UPLOAD_SIZE_MB",
      "ADMIN_EMAIL",
      "ADMIN_PASSWORD_HASH",
      "SESSION_SECRET",
    ],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1,
    },
  },
}
