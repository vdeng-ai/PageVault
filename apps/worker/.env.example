# Local development: apps/worker/.env
# Deployment secrets file: apps/worker/.env.production
APP_ENV=production
PUBLIC_BASE_URL=https://h.example.com
ADMIN_BASE_URL=https://admin-html.example.com
DEFAULT_URL_EXPIRE_DAYS=15
DEFAULT_FILE_EXPIRE_DAYS=30
MAX_UPLOAD_SIZE_MB=10
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace-with-password-hash
SESSION_SECRET=replace-with-long-random-secret

# Optional ChatGPT/MCP integration; apply migrations 0008 and 0009 before enabling.
MCP_ENABLED=false
# MCP_OAUTH_CLIENT_ID=pagevault-chatgpt
# MCP_OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
# MCP_OAUTH_CLIENT_SECRET=generated-secret-for-a-confidential-client-only
# MCP_FILE_ALLOWED_HOSTS=.oaiusercontent.com
MAINTENANCE_GC_LIMIT=100
