{
  "name": "@pagevault/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "pnpm --filter @pagevault/core run build && wrangler types src/worker-configuration.d.ts --strict-vars false && tsc -p tsconfig.json",
    "deploy": "wrangler deploy --keep-vars --secrets-file .env.production",
    "deploy:dry-run": "wrangler deploy --dry-run --keep-vars --secrets-file .env.production",
    "dev": "wrangler dev",
    "gc": "node dist/cli.js gc",
    "lint": "eslint src --max-warnings=0",
    "start": "node dist/node-server.js",
    "test": "vitest run src",
    "typecheck": "pnpm --filter @pagevault/core run build && wrangler types src/worker-configuration.d.ts --strict-vars false && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.18.2",
    "@pagevault/core": "workspace:*",
    "hono": "^4.8.10",
    "markdown-it": "^14.1.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "wrangler": "^4.30.0"
  }
}
